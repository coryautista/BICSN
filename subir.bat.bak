@echo off
setlocal

REM === 1) Generar el RAR (llama tu bat anterior) ===
call "%~dp0generar_rar.bat"
if errorlevel 1 exit /b 1

REM === 2) Datos de destino ===
set "FILE=%~dp0BICSN.rar"
set "USER=des"
set "HOST=10.20.1.90"
set "PORT=22"
set "REMOTE_DIR=/home/des"  REM cambia la ruta

REM === 3) Copiar por SSH ===
scp -P %PORT% "%FILE%" %USER%@%HOST%:"%REMOTE_DIR%/BICSN.rar"
if errorlevel 1 (
  echo [ERROR] Fallo SCP
  pause
  exit /b 1
)

echo [OK] Subido a %USER%@%HOST%:%REMOTE_DIR%/BICSN.rar
pause
